datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  // Nossas informações customizadas da Gruta!
  roles         String[]  @default(["guest"])
  joined_date   DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  playerProfile    PlayerProfile?
  dailyCompletions DailyCompletion[]
  gameStats        GameStat[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  date        String
  time        String
  category    String
  bannerUrl   String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  is_visible  Boolean  @default(true)
}

model Game {
  id         String   @id @default(uuid())
  title      String
  category   String
  image      String
  badge      String?
  is_visible Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Gallery {
  id           String   @id @default(uuid())
  img          String
  caption      String?
  date         String
  tags         String[]
  isHallOfFame Boolean  @default(false)
  aspect       String   @default("4:3")
  is_visible   Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PlayerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  level            Int      @default(1)
  xp               Int      @default(0)
  coins            Int      @default(0)
  torchCurrentDays Int      @default(0)
  torchRecordDays  Int      @default(0)
  torchLastLitDate String?
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyCompletion {
  id          String   @id @default(cuid())
  userId      String
  gameId      String
  dateKey     String
  won         Boolean  @default(true)
  attempts    Int?
  score       Int?
  state       Json?
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId, dateKey])
  @@index([userId, dateKey])
}

model GameStat {
  id            String   @id @default(cuid())
  userId        String
  gameId        String
  played        Int      @default(0)
  wins          Int      @default(0)
  currentStreak Int      @default(0)
  maxStreak     Int      @default(0)
  extra         Json?
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}